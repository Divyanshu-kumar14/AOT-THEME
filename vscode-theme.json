        "input.foreground": "#e8dcd4",
        "input.placeholderForeground": "#8c5a5a",
        "inputOption.activeBackground": "#ff3b2c40",
        "inputOption.activeBorder": "#ff3b2c",
        "inputOption.activeForeground": "#e8dcd4",
        "inputOption.hoverBackground": "#8c5a5a",
        "inputValidation.errorBackground": "#ff3b2c20",
