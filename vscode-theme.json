{
    "name": "Omarchy",
    "$schema": "vscode://schemas/color-theme",
    "type": "dark",
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "parameter": "#ff5c35",
        "parameter.declaration": "#ff5c35",
        "variable": "#e8dcd4",
        "variable.declaration": "#e8dcd4",
        "variable.readonly": "#ffc080",
        "variable.defaultLibrary": "#e8dcd4",
        "property": "#ff5c35",
        "property.declaration": "#ff5c35",
        "property.readonly": "#ff5c35",
        "function": "#6aa5ff",
        "function.declaration": "#6aa5ff",
        "function.defaultLibrary": "#ff5c35",
        "method": "#6aa5ff",
        "method.declaration": "#6aa5ff",
        "class": "#ffa855",
        "class.declaration": "#ffa855",
        "class.defaultLibrary": "#ffa855",
        "interface": "#ffa855",
        "interface.declaration": "#ffa855",
        "enum": "#ffa855",
        "enumMember": "#ff6b35",
        "type": "#ffa855",
        "type.declaration": "#ffa855",
        "type.defaultLibrary": "#e8dcd4",
        "typeParameter": "#ffa855",
        "namespace": "#6aa5ff",
        "macro": "#ff77aa",
        "decorator": "#6aa5ff",
        "string": "#4ecb71",
        "number": "#ff6b35",
        "boolean": "#ff6b35",
        "regexp": "#ff7a55",
        "operator": "#8fb8ff",
        "keyword": "#ff77aa",
        "comment": {
            "foreground": "#4a2a2a",
            "fontStyle": "italic"
        },
        "comment.documentation": {
            "foreground": "#4a2a2a",
            "fontStyle": "italic"
        }
    },
    "colors": {
        "foreground": "#e8dcd4",
        "disabledForeground": "#8c5a5a",
        "focusBorder": "#ff3b2c80",
        "widget.shadow": "#0a040480",
        "selection.background": "#2a0a0a80",
