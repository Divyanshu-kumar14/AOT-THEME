        "list.inactiveSelectionBackground": "#8c5a5a40",
        "list.inactiveSelectionForeground": "#e8dcd4",
        "list.inactiveFocusBackground": "#8c5a5a40",
        "list.inactiveFocusOutline": "#8c5a5a",
        "list.invalidItemForeground": "#ff3b2c",
        "list.errorForeground": "#ff3b2c",
        "list.warningForeground": "#ffa855",
        "listFilterWidget.background": "#0a0404",
        "listFilterWidget.outline": "#ff3b2c",
        "listFilterWidget.noMatchesOutline": "#ff3b2c",
        "list.filterMatchBackground": "#ff3b2c30",
        "list.filterMatchBorder": "#ff3b2c",
        "tree.indentGuidesStroke": "#8c5a5a",
        "tree.inactiveIndentGuidesStroke": "#8c5a5a60",
        "tree.tableColumnsBorder": "#8c5a5a",
        "tree.tableOddRowsBackground": "#0a040440",
        "activityBar.background": "#0a0404",
        "activityBar.dropBorder": "#ff3b2c",
        "activityBar.foreground": "#e8dcd4",
        "activityBar.inactiveForeground": "#8c5a5a",
        "activityBar.border": "#0a0404",
        "activityBarBadge.background": "#ff3b2c",
        "activityBarBadge.foreground": "#0a0404",
        "activityBar.activeBorder": "#ff3b2c",
        "activityBar.activeBackground": "#0a040440",
        "sideBar.background": "#0a0404",
        "sideBar.foreground": "#e8dcd4",
        "sideBar.border": "#0a0404",
        "sideBar.dropBackground": "#ff3b2c20",
        "sideBarTitle.foreground": "#e8dcd4",
        "sideBarSectionHeader.background": "#0a0404",
        "sideBarSectionHeader.foreground": "#e8dcd4",
        "sideBarSectionHeader.border": "#8c5a5a40",
        "minimap.findMatchHighlight": "#ff3b2c80",
        "minimap.selectionHighlight": "#ff3b2c60",
        "minimap.errorHighlight": "#ff3b2c",
        "minimap.warningHighlight": "#ffa855",
        "minimap.background": "#0a0404",
        "minimap.selectionOccurrenceHighlight": "#ff3b2c40",
        "minimap.foregroundOpacity": "#0a0404c0",
        "minimapSlider.background": "#8c5a5a20",
        "minimapSlider.hoverBackground": "#8c5a5a40",
        "minimapSlider.activeBackground": "#8c5a5a60",
        "minimapGutter.addedBackground": "#4ecb71",
        "minimapGutter.modifiedBackground": "#ff6b35",
        "minimapGutter.deletedBackground": "#ff3b2c",
        "editorGroup.border": "#8c5a5a40",
        "editorGroup.dropBackground": "#ff3b2c20",
        "editorGroup.dropIntoPromptForeground": "#e8dcd4",
        "editorGroup.dropIntoPromptBackground": "#0a0404",
        "editorGroup.dropIntoPromptBorder": "#ff3b2c",
        "editorGroupHeader.noTabsBackground": "#0a0404",
        "editorGroupHeader.tabsBackground": "#0a0404",
        "editorGroupHeader.tabsBorder": "#0a0404",
        "editorGroupHeader.border": "#0a0404",
        "editorGroup.emptyBackground": "#0a0404",
        "tab.activeBackground": "#0a0404",
        "tab.unfocusedActiveBackground": "#0a0404",
        "tab.activeForeground": "#e8dcd4",
        "tab.activeBorder": "#ff3b2c",
        "tab.activeBorderTop": "#ff3b2c",
        "tab.unfocusedActiveBorder": "#8c5a5a",
        "tab.unfocusedActiveBorderTop": "#8c5a5a",
        "tab.border": "#0a0404",
        "tab.inactiveBackground": "#0a0404",
        "tab.inactiveForeground": "#8c5a5a",
        "tab.unfocusedActiveForeground": "#e8dcd4",
        "tab.unfocusedInactiveForeground": "#8c5a5a",
        "tab.hoverBackground": "#8c5a5a40",
        "tab.unfocusedHoverBackground": "#8c5a5a40",
        "tab.hoverForeground": "#e8dcd4",
        "tab.hoverBorder": "#ff3b2c40",
        "tab.activeModifiedBorder": "#ffa855",
        "tab.inactiveModifiedBorder": "#ffa85580",
        "peekViewEditor.background": "#0a0404",
        "peekViewResult.background": "#0a0404",
        "peekViewTitle.background": "#0a0404",
        "peekViewTitleLabel.foreground": "#e8dcd4",
        "peekViewTitleDescription.foreground": "#8c5a5a",
        "peekViewBorder.color": "#ff3b2c",
        "merge.currentHeaderBackground": "#6aa5ff20",
        "merge.incomingHeaderBackground": "#ff77aa20",
        "merge.currentContentBackground": "#0a0404",
        "merge.incomingContentBackground": "#0a0404",
        "merge.border": "#8c5a5a40",
        "diffEditor.insertedLineBackground": "#4ecb7120",
        "diffEditor.removedLineBackground": "#ff3b2c20",
        "diffEditor.insertedTextBackground": "#4ecb7140",
        "diffEditor.removedTextBackground": "#ff3b2c40",
        "diffEditor.border": "#8c5a5a40",
        "notebook.output.baseBackground": "#0a0404",
        "notebook.output.textErrorForeground": "#ff3b2c",
        "notebook.output.textInfoForeground": "#6aa5ff",
        "notebook.output.textWarningForeground": "#ffa855",
        "terminal.background": "#0a0404",
        "terminal.foreground": "#e8dcd4",
        "terminal.selectionBackground": "#2a0a0a80",
        "cursor.background": "#ff3b2c",
        "cursor.foreground": "#0a0404",
        "terminal.ansiBlack": "#050202",
        "terminal.ansiRed": "#ff3b2c",
        "terminal.ansiGreen": "#4ecb71",
        "terminal.ansiYellow": "#ffa855",
        "terminal.ansiBlue": "#6aa5ff",
        "terminal.ansiMagenta": "#ff77aa",
        "terminal.ansiCyan": "#ff5c35",
        "terminal.ansiWhite": "#e8dcd4",
        "terminal.ansiBrightBlack": "#8c5a5a",
        "terminal.ansiBrightRed": "#ff5c35",
        "terminal.ansiBrightGreen": "#6cf08c",
        "terminal.ansiBrightYellow": "#ffc080",
        "terminal.ansiBrightBlue": "#8fb8ff",
        "terminal.ansiBrightMagenta": "#ff9bcc",
        "terminal.ansiBrightCyan": "#ff7a55",
        "terminal.ansiBrightWhite": "#f4e8d7",
        "editor.background": "#0a0404",
        "editor.foreground": "#e8dcd4",
        "editor.selectionBackground": "#2a0a0a",
        "editor.selectionHighlightBackground": "#ff3b2c30",
        "editor.wordHighlightBackground": "#ff3b2c20",
        "editor.wordHighlightStrongBackground": "#ff3b2c40",
        "editor.findMatchBackground": "#ff3b2c40",
        "editor.findMatchHighlightBackground": "#ff3b2c60",
        "editor.findRangeHighlightBackground": "#ff3b2c20",
        "editor.lineHighlightBackground": "#1a0a0a",
        "editor.cursorBackground": "#ff3b2c",
        "editor.cursor.foreground": "#0a0404",
        "editor.inactiveSelectionBackground": "#2a0a0a40",
        "editor.selectionHighlightBorder": "#ff3b2c",
        "editor.link.activeForeground": "#8fb8ff",
        "editor.error.foreground": "#ff3b2c",
        "editor.warning.foreground": "#ffa855",
        "editor.info.foreground": "#6aa5ff",
        "editor.hint.foreground": "#ff5c35",
        "editor.bracketMatch.background": "#ff3b2c30",
        "editor.hoverHighlightBackground": "#ff3b2c20",
        "editor.rangeHighlightBackground": "#ff3b2c20",
        "editor.rangeHighlightBorder": "#ff3b2c",
        "editor.symbolHighlightBackground": "#ff3b2c20",
        "editor.stackFrameHighlightBackground": "#ff3b2c30",
        "editor.focusedStackFrameHighlightBackground": "#ff3b2c50"
    },
    "tokenColors": [
        {
            "scope": [
                "comment",
                "punctuation.definition.comment"
            ],
            "settings": {
                "foreground": "#4a2a2a",
                "fontStyle": "italic"
            }
        },
        {
            "scope": [
                "constant",
                "entity.name.constant",
                "variable.other.constant",
                "support.constant"
            ],
            "settings": {
                "foreground": "#ffc080"
            }
        },
        {
            "scope": [
                "entity.name.type",
                "support.type",
                "meta.type"
            ],
            "settings": {
                "foreground": "#ffa855"
            }
        },
        {
            "scope": [
                "keyword",
                "storage.type",
                "storage.modifier"
            ],
            "settings": {
                "foreground": "#ff77aa"
            }
        },
        {
            "scope": [
                "storage.type.class",
                "storage.type.function"
            ],
            "settings": {
                "foreground": "#ff77aa"
            }
        },
        {
            "scope": [
                "entity.name.function",
                "support.function"
            ],
            "settings": {
                "foreground": "#6aa5ff"
            }
        },
        {
            "scope": [
                "variable.function",
                "variable.language"
            ],
            "settings": {
                "foreground": "#6aa5ff"
            }
        },
        {
            "scope": [
                "string",
                "string.quoted",
                "string.unquoted",
                "string.regexp",
                "string.template"
            ],
            "settings": {
                "foreground": "#4ecb71"
            }
        },
        {
            "scope": [
                "constant.numeric",
                "constant.language.boolean"
            ],
            "settings": {
                "foreground": "#ff6b35"
            }
        },
        {
            "scope": [
                "entity.name.tag",
                "entity.name.namespace"
            ],
            "settings": {
                "foreground": "#ff5c35"
            }
        },
        {
            "scope": [
                "entity.other.attribute-name",
                "support.type.property-name"
            ],
            "settings": {
                "foreground": "#ff5c35"
            }
        },
        {
            "scope": [
                "punctuation",
                "meta.brace",
                "meta.tag"
            ],
            "settings": {
                "foreground": "#8c5a5a"
            }
        },
        {
            "scope": [
                "keyword.control.import",
                "keyword.control.export",
                "keyword.control.from"
            ],
            "settings": {
                "foreground": "#ff77aa"
            }
        },
        {
            "scope": [
                "keyword.operator",
                "keyword.operator.new",
                "keyword.operator.assignment"
            ],
            "settings": {
                "foreground": "#8fb8ff"
            }
        },
        {
            "scope": [
                "support.function.builtin",
                "support.function.any-method"
            ],
            "settings": {
                "foreground": "#6aa5ff"
            }
        },
        {
            "scope": [
                "variable.parameter",
                "variable.other.readwrite"
            ],
            "settings": {
                "foreground": "#ff5c35"
            }
        },
        {
            "scope": [
                "invalid",
                "invalid.deprecated"
            ],
            "settings": {
                "foreground": "#ff3b2c",
                "fontStyle": "italic underline"
            }
        },
        {
            "scope": [
                "diff.header",
                "diff.deleted"
            ],
            "settings": {
                "foreground": "#ff3b2c"
            }
        },
        {
            "scope": [
                "diff.inserted",
                "diff.changed"
            ],
            "settings": {
                "foreground": "#4ecb71"
            }
        },
        {
            "scope": [
                "markup.heading",
                "markup.heading.1",
                "markup.heading.2",
                "markup.heading.3"
            ],
            "settings": {
                "foreground": "#6aa5ff",
                "fontStyle": "bold"
            }
        },
        {
            "scope": [
                "markup.bold"
            ],
            "settings": {
                "foreground": "#e8dcd4",
                "fontStyle": "bold"
            }
        },
        {
            "scope": [
                "markup.italic"
            ],
            "settings": {
                "foreground": "#e8dcd4",
                "fontStyle": "italic"
            }
        },
        {
            "scope": [
                "markup.link",
                "string.other.link"
            ],
            "settings": {
                "foreground": "#ff5c35"
            }
        },
        {
            "scope": [
                "markup.inline.raw",
                "markup.fenced_code.block",
                "string.regexp"
            ],
            "settings": {
                "foreground": "#4ecb71"
            }
        },
        {
            "scope": [
                "markup.quote",
                "punctuation.definition.quote"
            ],
            "settings": {
                "foreground": "#4a2a2a",
                "fontStyle": "italic"
            }
        },
        {
            "scope": [
                "markup.list",
                "punctuation.definition.list"
            ],
            "settings": {
                "foreground": "#ff5c35"
            }
        },
        {
            "scope": [
                "meta.object-literal.key",
                "string.unquoted.label.js"
            ],
            "settings": {
                "foreground": "#e8dcd4"
            }
        },
        {
            "scope": [
                "support.class",
                "support.type",
                "support.type.primitive"
            ],
            "settings": {
                "foreground": "#ffa855"
            }
        },
        {
            "scope": [
                "keyword.other.special-method",
                "variable.language.special.self"
            ],
            "settings": {
                "foreground": "#e8dcd4",
                "fontStyle": "italic"
            }
        },
        {
            "scope": [
                "constant.character",
                "constant.escape"
            ],
            "settings": {
                "foreground": "#ff7a55"
            }
        },
        {
            "scope": [
                "entity.name.section",
                "entity.name.section.markdown"
            ],
            "settings": {
                "foreground": "#ffa855",
                "fontStyle": "bold"
            }
        },
        {
            "scope": [
                "keyword.other.unit",
                "keyword.other.type"
            ],
            "settings": {
                "foreground": "#ff77aa"
            }
        }
    ]
}